{
  "name": "configurable-header-manager",
  "description": "Add, modify, or remove HTTP request and response headers per URL pattern.",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "author": "Marlon Wisskirchen",
  "homepage": "https://github.com/MarlonWiss2212/Configurable-Header-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarlonWiss2212/Configurable-Header-Manager.git"
  },
  "keywords": [
    "headers",
    "http",
    "chrome",
    "firefox",
    "edge",
    "declarativeNetRequest",
    "browser-extension"
  ],
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "oxlint src entrypoints tests",
    "lint:fix": "oxlint --fix src entrypoints tests",
    "fmt": "oxfmt --write src entrypoints tests wxt.config.ts vitest.config.ts",
    "fmt:check": "oxfmt --check src entrypoints tests wxt.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm compile && pnpm lint && pnpm fmt:check",
    "taze:minor": "taze minor -wIr",
    "taze:major": "taze major -wIr",
    "changeset": "changeset",
    "version": "changeset version",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "happy-dom": "^20.10.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "taze": "^19.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
